# Electronium Browser - Environment Configuration
# Copy to .env and fill in values. Never commit .env to git.

# HTTP bridge bind address - keep as 127.0.0.1, never set to 0.0.0.0
ELECTRONIUM_HOST=127.0.0.1

# HTTP bridge port
ELECTRONIUM_PORT=17373

# Chrome DevTools Protocol port - must match --remote-debugging-port flag used when launching Chrome
ELECTRONIUM_CDP_PORT=9222

# Auth token for the HTTP bridge. All non-health requests must include:
#   X-Electronium-Token: <this value>
# Generate one with: openssl rand -hex 32
ELECTRONIUM_TOKEN=

# Directory where screenshot ?out= saves are allowed to write.
# Path traversal outside this directory is blocked.
ELECTRONIUM_SCREENSHOT_DIR=/tmp

# Medium username for the extract-medium-profile script (no @ prefix)
MEDIUM_USERNAME=
